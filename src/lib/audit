import type { AuditEntry, SignerProof } from "./types";
import { sign, verify, type Identity } from "./identity";

const STORAGE_KEY = "onecode_audit_log_v2";
const hasLocalStorage = typeof localStorage !== "undefined";

async function sha256(text: string): Promise<string> {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
  return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
}

export function loadAuditLog(): AuditEntry[] {
  if (!hasLocalStorage) return [];
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? (JSON.parse(raw) as AuditEntry[]) : [];
  } catch {
    return [];
  }
}

function saveAuditLog(log: AuditEntry[]) {
  if (!hasLocalStorage) return;
  localStorage.setItem(STORAGE_KEY, JSON.stringify(log));
}

function canonicalPayload(seq: number, timestamp: string, action: string, details: Record<string, unknown>, prevHash: string): string {
  // Keys sorted so the payload is stable regardless of object construction
  // order — required for signatures/hashes to verify deterministically.
  const sortedDetails = Object.fromEntries(Object.entries(details).sort(([a], [b]) => a.localeCompare(b)));
  return JSON.stringify({ seq, timestamp, action, details: sortedDetails, prevHash });
}

export interface AuditItem {
  action: string;
  details: Record<string, unknown>;
  signers?: Identity[];
}

// All writers go through this single promise chain. localStorage reads and
// writes are synchronous, but hashing/signing in between is async — so two
// overlapping appends used to both read the same log tail, compute the same
// seq/prevHash, and the last save silently discarded the rest (a 50-entry
// burst left 1 entry, with a chain that still "verified"). Serialising every
// append makes the read-modify-write atomic within a tab.
let queue: Promise<unknown> = Promise.resolve();
function enqueue<T>(task: () => Promise<T>): Promise<T> {
  const run = queue.then(task, task);
  queue = run.catch(() => undefined);
  return run;
}

async function buildEntry(log: AuditEntry[], item: AuditItem): Promise<AuditEntry> {
  const prevHash = log.length > 0 ? log[log.length - 1].hash : "GENESIS";
  const seq = log.length;
  const timestamp = new Date().toISOString();
  const payload = canonicalPayload(seq, timestamp, item.action, item.details, prevHash);
  const hash = await sha256(payload);

  let signerProofs: SignerProof[] | undefined;
  if (item.signers && item.signers.length > 0) {
    signerProofs = await Promise.all(
      item.signers.map(async (id) => ({
        id: id.reviewerId,
        pub: id.publicKeyJwk,
        sig: await sign(id.privateKey, payload),
      }))
    );
  }
  return { seq, timestamp, action: item.action, details: item.details, prevHash, hash, signers: signerProofs };
}

/**
 * Append several entries in ONE atomic load -> extend -> save cycle. Used by
 * the pipeline so a run issuing thousands of codes does one localStorage
 * write instead of thousands (each re-serialising the whole growing log).
 */
export function appendAuditBatch(items: AuditItem[]): Promise<AuditEntry[]> {
  return enqueue(async () => {
    if (items.length === 0) return [];
    const log = loadAuditLog();
    const added: AuditEntry[] = [];
    for (const item of items) {
      const entry = await buildEntry(log, item);
      log.push(entry);
      added.push(entry);
    }
    saveAuditLog(log);
    return added;
  });
}

/**
 * Append a new entry, chained to the previous one's hash. Never edits or
 * removes prior entries — a human override is a NEW entry referencing what
 * it supersedes (via details.supersedes), so the original AI decision is
 * always still visible in the chain.
 *
 * `signers` carries real ECDSA signatures (see identity.ts) — pass one
 * identity for a normal confirm/reject, two for a dual-signed high-risk
 * override. An entry with signers can be independently verified later by
 * verifyAuditChain() even if the raw log file were copied elsewhere.
 */
export async function appendAuditEntry(
  action: string,
  details: Record<string, unknown>,
  signers?: Identity[]
): Promise<AuditEntry> {
  const [entry] = await appendAuditBatch([{ action, details, signers }]);
  return entry;
}

export interface ChainVerification {
  valid: boolean;
  brokenAt: number | null;
  invalidSignatureAt: number | null;
}

/** Recomputes every hash in the chain and, for entries with signers,
 * cryptographically verifies each signature against its stated payload. */
export async function verifyAuditChain(): Promise<ChainVerification> {
  const log = loadAuditLog();
  for (let i = 0; i < log.length; i++) {
    const entry = log[i];
    const expectedPrev = i === 0 ? "GENESIS" : log[i - 1].hash;
    if (entry.prevHash !== expectedPrev) return { valid: false, brokenAt: i, invalidSignatureAt: null };

    const payload = canonicalPayload(entry.seq, entry.timestamp, entry.action, entry.details, entry.prevHash);
    const recomputed = await sha256(payload);
    if (recomputed !== entry.hash) return { valid: false, brokenAt: i, invalidSignatureAt: null };

    if (entry.signers) {
      for (const s of entry.signers) {
        if (!s.sig) continue;
        const ok = await verify(s.pub, payload, s.sig);
        if (!ok) return { valid: false, brokenAt: null, invalidSignatureAt: i };
      }
    }
  }
  return { valid: true, brokenAt: null, invalidSignatureAt: null };
}

export function clearAuditLog() {
  localStorage.removeItem(STORAGE_KEY);
}

export function computeRunDigestSync(log: AuditEntry[]): string {
  return log.length > 0 ? log[log.length - 1].hash.slice(0, 12) : "GENESIS";
}

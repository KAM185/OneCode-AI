import { useMemo, useState } from "react";
import ExportPanel from "./components/ExportPanel";
import EconomicsPanel from "./components/EconomicsPanel";
import SubstitutionPanel from "./components/SubstitutionPanel";
import LifecyclePanel from "./components/LifecyclePanel";
import UploadPanel from "./components/UploadPanel";
import Dashboard from "./components/Dashboard";
import ReviewQueue from "./components/ReviewQueue";
import ResultsTable from "./components/ResultsTable";
import KnowledgeGraph from "./components/KnowledgeGraph";
import AuditPanel from "./components/AuditPanel";
import ValidationLab from "./components/ValidationLab";
import ExplainDrawer from "./components/ExplainDrawer";
import { buildGraph } from "./lib/graph";
import { scenarioPairs } from "./lib/validationData";
import { runPipeline, type CpseUpload } from "./lib/pipeline";
import { checkAndPublishFingerprints } from "./lib/backend";
import { applyReview } from "./lib/review";
import { applySupersessions, loadSubstitutions, loadSupersessions, mergeLink, saveSubstitutions, saveSupersessions, type SupersessionMap } from "./lib/registry";
import type { MappingEntry, PipelineResult, SubstitutionLink } from "./lib/types";

type Tab = "overview" | "matching" | "review" | "registry" | "graph" | "audit" | "export";
const TABS: { id: Tab; label: string }[] = [
  { id: "overview", label: "Dashboard" },
  { id: "matching", label: "AI Matching & Explainability" },
  { id: "review", label: "Review Queue" },
  { id: "registry", label: "Registry & Cross-CPSE" },
  { id: "graph", label: "Knowledge Graph / Material 360°" },
  { id: "audit", label: "Audit & Validation" },
  { id: "export", label: "Economics & Export" },
];

export default function App() {
  const [result, setResult] = useState<PipelineResult | null>(null);
  const [running, setRunning] = useState(false);
  const [progress, setProgress] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [tab, setTab] = useState<Tab>("overview");
  const [crossCpseNotes, setCrossCpseNotes] = useState<string[]>([]);
  const [indexReachable, setIndexReachable] = useState<boolean | null>(null);
  const [links, setLinks] = useState<SubstitutionLink[]>(() => loadSubstitutions());
  const [supersessions, setSupersessions] = useState<SupersessionMap>(() => loadSupersessions());
  const [evidence, setEvidence] = useState<MappingEntry | null>(null);
  const [labSize, setLabSize] = useState<number | null>(scenarioPairs.length);

  async function handleRun(uploads: CpseUpload[]) {
    setRunning(true);
    setCrossCpseNotes([]);
    setIndexReachable(null);
    setError(null);
    try {
      const r = await runPipeline(uploads, setProgress, { supersessions });
      setResult(r);
      setTab("overview");

      setProgress("Checking cross-CPSE fingerprint index…");
      const byCpse = new Map<string, Set<string>>();
      for (const m of r.mapping) {
        (byCpse.get(m.cpseId) ?? byCpse.set(m.cpseId, new Set()).get(m.cpseId)!).add(m.currentNmcCode ?? m.nmcCode);
      }
      const notes: string[] = [];
      let reachable = true;
      for (const [cpseId, codes] of byCpse) {
        const check = await checkAndPublishFingerprints([...codes], cpseId);
        if (!check.reachable) { reachable = false; break; }
        for (const [code, others] of check.matches) notes.push(`${code} already in use by ${others.join(", ")} — confirms cross-CPSE convergence`);
      }
      setIndexReachable(reachable);
      setCrossCpseNotes(notes);
    } catch (e) {
      setResult(null);
      setError(e instanceof Error && e.name !== "" && e.message ? e.message : "The pipeline failed unexpectedly.");
    } finally {
      setRunning(false);
      setProgress("");
    }
  }

  function handleResolve(entry: MappingEntry, outcome: "confirmed" | "rejected", reviewers: string[], auditSeq: number) {
    if (!result) return;
    const applied = applyReview(result, entry, outcome, reviewers, supersessions, auditSeq);
    setResult(applied.result);
    if (applied.link) {
      // Persist the validated substitution — this is what builds the
      // reusable reference table, beyond flipping a status on one row.
      const next = mergeLink(links, applied.link);
      setLinks(next);
      saveSubstitutions(next);
    }
  }

  function handleSupersessionsChange(next: SupersessionMap) {
    saveSupersessions(next);
    setSupersessions(next);
    if (result) setResult(applySupersessions(result, next));
  }

  const materialMap = useMemo(() => new Map((result?.materials ?? []).map((m) => [m.id, m])), [result]);
  const reviewQueue = result?.mapping.filter((m) => m.status === "pending-review") ?? [];

  const relationships = useMemo(() => (result ? buildGraph(result, links, supersessions).edges.length : 0), [result, links, supersessions]);
  const evidencePool = useMemo(() => (result?.mapping ?? []).filter((m) => m.decision.matchedMaterialId && m.decision.verdict !== "distinct"), [result]);

  return (
    <div className="app-shell">
      <header className="app-header">
        <div style={{ width: 32, height: 32, borderRadius: 6, background: "var(--accent-bg)", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--accent)", fontWeight: 700 }}>NC</div>
        <div>
          <p style={{ fontSize: 16, fontWeight: 600, margin: 0 }}>OneCode AI</p>
          <p style={{ fontSize: 12, color: "var(--text-muted)", margin: 0 }}>
            National material code portal — Ministry of Petroleum &amp; Natural Gas · SIH 2026 (PS 26099)
          </p>
        </div>
      </header>

      <div className="card" style={{ marginBottom: 16 }}>
        <UploadPanel onRun={handleRun} running={running} progress={progress} />
        {error && <div className="panel alert-error" role="alert"><b>Could not process upload.</b> {error}</div>}
      </div>
      {!result && !running && !error && <p className="empty-note">Upload one file per CPSE to begin. Results, review queue, registry and audit trail appear here.</p>}

      {result && (
        <>
          <nav className="tabs" role="tablist" aria-label="Modules">
            {TABS.map((t) => (
              <button key={t.id} role="tab" aria-selected={tab === t.id} className={`tab${tab === t.id ? " active" : ""}`} onClick={() => setTab(t.id)}>
                {t.label}{t.id === "review" && reviewQueue.length > 0 ? <span className="tab-count">{reviewQueue.length}</span> : null}
              </button>
            ))}
          </nav>

          {tab === "overview" && (
            <>
              <div className="card" style={{ marginBottom: 16 }}><Dashboard result={result} nav={{ relationships, evidencePairs: evidencePool.length, validationPairs: labSize, onOpenGraph: () => setTab("graph"), onOpenValidation: () => setTab("audit"),
                onOpenEvidence: () => setEvidence(evidencePool.find((m) => m.status === "pending-review") ?? evidencePool[0] ?? null) }} /></div>
              {indexReachable === false && (
                <div className="card" style={{ marginBottom: 16 }}>
                  <div className="panel" style={{ fontSize: 12, color: "var(--text-secondary)" }}>
                    Cross-CPSE index unreachable (function not deployed, or offline) — cross-CPSE convergence was not checked for this run.
                  </div>
                </div>
              )}
              {crossCpseNotes.length > 0 && (
                <div className="card" style={{ marginBottom: 16 }}>
                  <div className="panel">
                    <p style={{ fontSize: 13, fontWeight: 600, margin: "0 0 8px" }}>Cross-CPSE matches</p>
                    <ul style={{ fontSize: 12, color: "var(--text-secondary)", margin: 0, paddingLeft: 18 }}>
                      {crossCpseNotes.map((n, i) => <li key={i}>{n}</li>)}
                    </ul>
                  </div>
                </div>
              )}
            </>
          )}
          {tab === "matching" && <div className="card" style={{ marginBottom: 16 }}><ResultsTable result={result} /></div>}
          {tab === "review" && <div className="card" style={{ marginBottom: 16 }}><ReviewQueue materials={materialMap} entries={reviewQueue} onResolve={handleResolve} /></div>}
          {tab === "registry" && (
            <>
              <div className="card" style={{ marginBottom: 16 }}><SubstitutionPanel links={links} /></div>
              <div className="card" style={{ marginBottom: 16 }}><LifecyclePanel records={result.records} supersessions={supersessions} onChange={handleSupersessionsChange} /></div>
            </>
          )}
          {tab === "graph" && <div id="knowledge-graph" className="card" style={{ marginBottom: 16 }}><KnowledgeGraph result={result} links={links} supersessions={supersessions} /></div>}
          {tab === "audit" && (
            <>
              <div className="card" style={{ marginBottom: 16 }}><AuditPanel /></div>
              <div id="validation-lab" className="card" style={{ marginBottom: 16 }}><ValidationLab confirmedLinks={links.length} onDatasetSize={setLabSize} /></div>
            </>
          )}
          {tab === "export" && (
            <>
              <div className="card" style={{ marginBottom: 16 }}><EconomicsPanel result={result} /></div>
              <div className="card" style={{ marginBottom: 16 }}><ExportPanel result={result} links={links} /></div>
            </>
          )}
        </>
      )}

      {!result && (
        <div id="validation-lab" className="card" style={{ marginBottom: 16 }}><ValidationLab confirmedLinks={links.length} onDatasetSize={setLabSize} /></div>
      )}
      {evidence && <ExplainDrawer entry={evidence} materials={materialMap} onClose={() => setEvidence(null)} />}
    </div>
  );
}
